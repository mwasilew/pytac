def reset()
	logComment ====== reset sequence start ======
	usb0 1
	usb1 1
	pkey 0
	volup 0
	voldn 0
	pedl 0
	delay 900
	usb0 0
	usb1 0
	delay 30
	pkey 1
	delay $reset
	pkey 0
	logComment ====== reset sequence finish ======

def bootToEDL()
	logComment ====== bootToEDL start ======
	usb0 1
	usb1 1
	pkey 0
	volup 0
	voldn 0
	pedl 1
	delay 900
	usb0 0
	usb1 0
	delay 30
	pkey 1
	delay $edl
	pkey 0
	pedl 0
	logComment ====== bootToEDL finish ======

def bootToUEFI()
	logComment ====== bootToUEFIMenu start ======
	// Put buttons in a set state
	pkey 0
	pedl 0
	volup 0
	delay 900
	pkey 1
	delay 900
	volup 1
	delay $uefi
	volup 0
	delay 900
	pkey 0
	logComment ====== bootToUEFIMenu finish ======
