def bootToBatteryEDL()
	logComment ====== bootToBatteryEDL start ======
	pedl 1 //set EDL high
	voldn 1 //reset MTP after 115 seconds
	delay 14000
	pkey 1
	delay 1300
	pkey 0
	//reset buttons
	delay 6000
	voldn 0
	pedl 0
	logComment ====== bootToBatteryEDL finish ======

def batteryReset()
	logComment ====== batteryReset ======
	pedl 0 //reset EDL
	voldn 1 //reset MTP after 14 seconds
	delay 14000
	pkey 1
	delay 1300
	pkey 0
	delay 6000
	voldn 0 //release voldn to stop MTP reset
	logComment ======  batteryReset ======
