def powerCycle()
	logComment ====== powerCycle sequence start ======
	powerOff
	delay $pcycle
	powerOn
	logComment ====== powerCycle sequence finish ======

def enASM()
	logComment ====== enASM start ======
	smuxs1 1
	smuxs2 1
	logComment ====== enASM finished ======

def enS230()
	logComment ====== enS230 start ======
	smuxs1 0
	sumxs2 1
	logComment ====== enS230 finished ======

def enIAM()
	logComment ====== enIAM start ======
	smuxs1 1
	smuxs2 0
	logComment ====== enIAM finished ======

def enS330()
	logComment ====== enS330 start ======
	smuxs1 0
	smuxs2 0
	logComment ====== enS330 finished ======
