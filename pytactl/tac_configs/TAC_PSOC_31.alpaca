def powerOffTheDevice()
	logComment ====== powerOffTheDevice sequence start ======
	12vpoweroff 1
	NADusb 1
	EAPusb 1
	logComment ====== powerOffTheDevice sequence finish ======

def powerOnTheDevice()
	logComment ====== powerOnTheDevice sequence start ======
	delay 500
	12vpoweroff 0
	delay 900
	NADusb 0
	EAPusb 0
	delay 30
	logComment ====== powerOnTheDevice sequence finish ======

def powerOff()
	logComment ====== powerOff start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	NADedl 0
	logComment ====== powerOff finish ======

def powerOn()
	logComment ====== powerOn start ======
	powerOff
	powerOnTheDevice
	pkey 1
	delay 800
	pkey 0
	logComment ====== powerOn finish ======

def bootToNADEDL()
	logComment ====== bootToEDL start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	NADedl 1
	powerOnTheDevice
	pkey 1
	delay 1300
	pkey 0
	NADedl 0
	logComment ====== bootToEDL finish ======

def bootToEAPEDL()
	logComment ====== bootToSecondaryEDL start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	EAPedl 1
	powerOnTheDevice
	pkey 1
	delay 800
	pkey 0
	delay 1300
	EAPedl 0
	logComment ====== bootToSecondaryEDL finish ======

def bootToUEFI()
	logComment ====== bootToUEFIMenu start ======
	powerOffTheDevice
	// Put buttons in a set state
	pkey 0
	volup 1
	voldn 0
	NADedl 0
	powerOnTheDevice
	pkey 1
	delay 8000
	pkey 0
	volup 0
	delay 12
	pkey 1
	volup 1
	pkey 0
	volup 0
	logComment ====== bootToUEFIMenu finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 1
	NADedl 0
	powerOnTheDevice
	pkey 1
	delay 800
	pkey 0
	delay 8000
	voldn 0
	delay 30
	voldn 1
	voldn 0
	logComment ====== bootToFastboot finished ======
