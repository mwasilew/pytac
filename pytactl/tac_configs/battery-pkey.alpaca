// Alpaca script shared by the boards whose power functions switch the
// battery and the power key together (the CSM boards). Listed first in a
// config's "script_ref", like common.alpaca, with the board's own script, if
// any, after it; functions the board lacks are named in "script_omit".
//
// Every delay is a variable, set per board in the pinout's "variables".

def powerOffTheDevice()
	logComment ====== powerOffTheDevice start ======
	battery 1
	pkey 0
	logComment ====== powerOffTheDevice finish ======

def powerOnTheDevice()
	logComment ====== powerOnTheDevice start ======
	delay $powerOffHold
	battery 0
	pkey 1
	delay $powerOnDelay
	logComment ====== powerOnTheDevice finish ======

def powerOff()
	logComment ====== powerOff start ======
	powerOffTheDevice
	pkey 0
	pedl 0
	logComment ====== powerOff finish ======

def powerOn()
	logComment ====== powerOn start ======
	powerOnTheDevice
	delay $powerKeyDelay
	pkey 1
	pkey 0
	logComment ====== powerOn finish ======

def bootToEDL()
	logComment ====== bootToEDL start ======
	powerOffTheDevice
	pedl 1
	powerOnTheDevice
	delay $edl
	pedl 0
	logComment ====== bootToEDL finish ======

def bootToEUD()
	logComment ====== bootToEUD start ======
	powerOffTheDevice
	eud 1
	powerOnTheDevice
	delay $eud
	eud 0
	logComment ====== bootToEUD finish ======

def bootToUEFI()
	logComment ====== bootToUEFI start ======
	powerOffTheDevice
	powerOnTheDevice
	delay $uefi
	pkey 0
	logComment ====== bootToUEFI finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 1
	pedl 0
	powerOnTheDevice
	pkey 1
	delay $fastbootPress
	pkey 0
	delay $fastboot
	voldn 0
	delay $fastbootRepeatDelay
	voldn 1
	voldn 0
	logComment ====== bootToFastboot finish ======
