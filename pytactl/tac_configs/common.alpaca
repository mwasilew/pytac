// Alpaca script shared by the TAC configs whose boards follow the common
// battery/USB/power-key/volume-key/EDL wiring.
//
// A config uses it by listing it first in "script_ref". Shared variants
// (common-*.alpaca) listed after it redefine functions for a wiring difference
// several boards have; functions a board does differently are redefined
// in the config's own .alpaca file, listed last, and functions the board
// lacks are named in "script_omit".
//
// Every delay is a variable, so that timings are set per board in the
// pinout's "variables". A delay marked "optional" is 0 on boards that do not
// need it. When converting a config, pytactl matches its script against
// these functions to decide what it can share (factor_script in
// pytactl/tacconfig.py).

def powerOffTheDevice()
	logComment ====== powerOffTheDevice start ======
	battery 1
	usb0 1
	usb1 1
	logComment ====== powerOffTheDevice finish ======

def powerOnTheDevice()
	logComment ====== powerOnTheDevice start ======
	delay $powerOffHold
	battery 0
	delay $batteryDelay
	usb0 0
	usb1 0
	delay $usbDelay
	logComment ====== powerOnTheDevice finish ======

def powerOff()
	logComment ====== powerOff start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	pedl 0
	logComment ====== powerOff finish ======

def powerOn()
	logComment ====== powerOn start ======
	powerOff
	powerOnTheDevice
	pkey 1
	delay $powerKeyPress
	pkey 0
	logComment ====== powerOn finish ======

def bootToEDL()
	logComment ====== bootToEDL start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	pedl 1
	powerOnTheDevice
	pkey 1
	delay $edl
	pkey 0
	delay $edlRelease // optional
	pedl 0
	logComment ====== bootToEDL finish ======

def bootToSecondaryEDL()
	logComment ====== bootToSecondaryEDL start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 0
	sedl 1
	powerOnTheDevice
	pkey 1
	delay $secondaryEdlPress
	pkey 0
	delay $secondaryEdl
	sedl 0
	logComment ====== bootToSecondaryEDL finish ======

def bootToUEFI()
	logComment ====== bootToUEFI start ======
	powerOffTheDevice
	pkey 0
	volup 1
	voldn 0
	pedl 0
	powerOnTheDevice
	delay $uefiPowerOnDelay // optional
	pkey 1
	delay $uefi
	pkey 0
	volup 0
	delay $uefiRepeatDelay
	pkey 1
	volup 1
	pkey 0
	volup 0
	logComment ====== bootToUEFI finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 1
	pedl 0
	powerOnTheDevice
	pkey 1
	delay $fastbootPress
	pkey 0
	delay $fastboot
	voldn 0
	delay $fastbootRepeatDelay
	voldn 1
	voldn 0
	logComment ====== bootToFastboot finish ======
