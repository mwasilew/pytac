def powerOffTheDevice()
	logComment ====== powerOffTheDevice sequence start ======
	battery 1
	pkey 0
	logComment ====== powerOffTheDevice sequence finish ======

def powerOnTheDevice()
	logComment ====== powerOnTheDevice sequence start ======
	delay 500
	battery 0
	pkey 1
	delay 900
	logComment ====== powerOnTheDevice sequence finish ======

def bootToEDL()
	logComment ====== bootToEDL start ======
	powerOffTheDevice
	pedl 1
	powerOnTheDevice
	delay 3000
	pedl 0
	logComment ====== bootToEDL finish ======

def bootToEUD()
	logComment ====== bootToEUD start ======
	powerOffTheDevice
	eud 1
	powerOnTheDevice
	delay 3000
	eud 0
	logComment ====== bootToEUD finish ======

def bootToUEFI()
	logComment ====== bootToUEFI start ======
	powerOffTheDevice
	powerOnTheDevice
	delay 2000
	pkey 0
	logComment ====== bootToUEFI finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOffTheDevice
	pkey 0
	volup 0
	voldn 1
	pedl 0
	powerOnTheDevice
	pkey 1
	delay 8000
	pkey 0
	delay 8000
	voldn 0
	delay 30
	voldn 1
	voldn 0
	logComment ====== bootToFastboot finished ======
