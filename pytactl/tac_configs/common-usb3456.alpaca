// Variant of common.alpaca for boards that also switch the usb3456 line
// with the other USB lines. Listed after common.alpaca in "script_ref", it
// replaces the two functions below and takes the same variables.

def powerOffTheDevice()
	logComment ====== powerOffTheDevice start ======
	battery 1
	usb0 1
	usb1 1
	usb3456 1
	logComment ====== powerOffTheDevice finish ======

def powerOnTheDevice()
	logComment ====== powerOnTheDevice start ======
	delay $powerOffHold
	battery 0
	delay $batteryDelay
	usb0 0
	usb1 0
	usb3456 0
	delay $usbDelay
	logComment ====== powerOnTheDevice finish ======
