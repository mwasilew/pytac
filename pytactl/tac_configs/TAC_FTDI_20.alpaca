def bootToUEFI()
	logComment ======bootToUEFI start ======
	powerOffTheDevice
	// Put buttons in a set state
	pkey 0
	volup 1
	voldn 0
	pedl 0
	powerOnTheDevice
	pkey 1
	delay 8000
	pkey 0
	volup 0
//	delay 12
//	pkey 1
//	volup 1
//	pkey 0
//	volup 0
	logComment ====== bootToUEFIu finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOffTheDevice
	delay 300
	battery 0
	pkey 0
	volup 0
	voldn 1
//	pedl 0
//	 powerOnTheDevice
	pkey 1
	delay 2000
	pkey 0
	delay 5000
	voldn 0
// 	delay 30
//	voldn 1
//	voldn 0
	logComment ====== bootToFastboot finished ======
