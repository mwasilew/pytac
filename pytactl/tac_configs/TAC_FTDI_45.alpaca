def bootToUEFI()
	logComment ====== bootToUEFIMenu start ======
	powerOffTheDevice
	// Put buttons in a set state
	pkey 0
	volup 0
	voldn 0
	pedl 0
	powerOnTheDevice
	delay $uefi
	pkey 1
	volup 1
	delay 4000
	pkey 0
	volup 0
	logComment ====== bootToUEFIMenu finish ======

def DisUSBVbus()
	logComment ====== DisUSBVbus sequence start ======
	usb0 1
	usb1 1
	logComment ====== DisUSBVbus sequence finish ======

def EnUSBVbus()
	logComment ====== EnUSBVbus sequence start ======
	usb0 0
	usb1 0
	logComment ====== EnUSBVbus sequence finish ======

def bootRCMToEDL()
	logComment ====== bootToEDL start ======
	pedl 1
	delay 18000
	voldn 1
	delay $rcmedl
	pedl 0
	voldn 0
	logComment ====== bootRCMToEDL finish ======
