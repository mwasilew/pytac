def powerOn()
	logComment ====== powerOn start ======
	powerOnTheDevice
	delay 30
	pkey 1
	delay $powerDelay
	pkey 0
	logComment ====== powerOn finish ======

def bootToEDL()
	logComment ====== bootToEDL start ======
	pkey 0
	volup 0
	voldn 0
	pedl 1
	pkey 1
	delay $edl
	pkey 0
	pedl 0
	logComment ====== bootToEDL finish ======

def bootToFastboot()
	logComment ====== bootToFastboot start ======
	powerOnTheDevice
	pkey 1
	delay 800
	voldn 1
	delay $fastboot1
	pkey 0
	delay $fastboot2
	voldn 0
	logComment ====== bootToFastboot finished ======
