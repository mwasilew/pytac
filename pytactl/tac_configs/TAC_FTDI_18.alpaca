def powerOn()
	logComment ====== on start ======
	pwr_off 0
	logComment ====== on finish ======

def powerOff()
	logComment ====== off start ======
	pwr_off 1
	logComment ====== off finish ======

def reset()
	logComment ====== reset start ======
	powerOff
	delay 1500
	powerOn
	logComment ====== reset finish ======

def bootToEDL()
	logComment ====== s1_md_sail_edl start ======
	sw_dnld 1
	ss_force_edl 1
	pmic_resin 1
	delay 1500
	pmic_resin 0
	delay 1000
	powerOn
	delay 5000
	delay $Optional_GPIO_Hold_Time
	sw_dnld 0
	ss_force_edl 0
	logComment ======  s1_md_sail_edl finish ======

def bootToUEFI()
	logComment ====== s1_uefi start ======
	pmic_resin 1
	delay 1500
	pmic_resin 0
	delay 1000
	kpd_pwr 0
	uefi 1
	sw_dnld 0
	kpd_pwr 1
	delay 8000
	delay $Optional_GPIO_Hold_Time
	kpd_pwr 0
	uefi 0
	logComment ====== s1_uefi finish ======

def bootToFastboot()
	logComment ====== s1_fastboot start ======
	pmic_resin 1
	delay 1500
	pmic_resin 0
	delay 800
	pmic_resin 1
	delay 8000
	delay $Optional_GPIO_Hold_Time
	pmic_resin 0
	logComment ====== s1_fastboot finish ======

def s1_reset()
	logComment ====== s1_reset start ======
	pmic_resin 1
	delay 1500
	pmic_resin 0
	logComment ====== s1_reset end ======

def s2_reset()
	logComment ====== s2_reset start ======
	s2_pmic_resin 1
	delay 1500
	s2_pmic_resin 0
	logComment ====== s2_reset end ======

def s2_md_sail_edl()
	logComment ====== s2_md_sail_edl start ======
	s2_sw_dnld 1
	s2_ss_force_edl 1
	s2_pmic_resin 1
	delay 1500
	s2_pmic_resin 0
	delay 1000
	powerOn
	delay 5000
	delay $Optional_GPIO_Hold_Time
	s2_sw_dnld 0
	s2_ss_force_edl 0
	logComment ======  s2_md_sail_edl finish ======

def s2_uefi_sequence()
	logComment ====== s2_uefi_sequence start ======
	s2_pmic_resin 1
	delay 1500
	s2_pmic_resin 0
	delay 1000
	s2_kpd_pwr 0
	s2_uefi 1
	s2_sw_dnld 0
	s2_kpd_pwr 1
	delay 8000
	delay $Optional_GPIO_Hold_Time
	s2_kpd_pwr 0
	s2_uefi 0
	logComment ====== s2_uefi_sequence finish ======

def s2_fastboot()
	logComment ====== s2_fastboot start ======
	s2_pmic_resin 1
	delay 1500
	s2_pmic_resin 0
	delay 800
	s2_pmic_resin 1
	delay 8000
	delay $Optional_GPIO_Hold_Time
	s2_pmic_resin 0
	logComment ====== s2_fastboot finish ======

def s2_Hboot_EDL_HOLD()
	logComment ====== s2_Hboot_EDL_HOLD start ======
	s2_sw_dnld 1
	s2_ss_force_edl 1
	logComment ====== s2_Hboot_EDL_HOLD finish ======

def s2_Hboot_EDL_RELEASE()
	logComment ====== s2_Hboot_EDL_RELEASE start ======
	s2_sw_dnld 0
	s2_ss_force_edl 0
	logComment ====== s2_Hboot_EDL_RELEASE finish ======

def classic_mode_set()
	logComment ====== classic_mode_set start ======
	s2_force_classic 1
	powerOff
	delay 1500
	powerOn
	logComment ====== classic_mode_set finish ======

def hboot_mode_set()
	logComment ====== hboot_mode_set start ======
	s2_force_classic 0
	logComment ====== hboot_mode_set finish ======
